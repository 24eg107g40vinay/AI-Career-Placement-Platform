# Configure these as operating-system environment variables before starting Spring Boot.
# Spring Boot does not automatically load a .env file.
DB_URL=jdbc:mysql://localhost:3306/career_platform?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=update
APP_FRONTEND_URL=http://localhost:5173
# Generate a random Base64-encoded secret with at least 32 bytes for HMAC-SHA256.
JWT_SECRET=
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
UPLOAD_DIR=uploads/resumes
